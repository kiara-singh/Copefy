# Copefy frontend environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Project settings -> API in the Supabase dashboard.

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The public anon key (safe to expose to the browser) — NOT the service_role / sb_secret key
VITE_SUPABASE_ANON_KEY=

# Base URL of the Copefy backend API
VITE_API_URL=http://localhost:8000

# Show agent trace panel (router, corpus, scores, dates). Raw retrieved text
# is never sent by the API.
VITE_RAG_DEBUG=false

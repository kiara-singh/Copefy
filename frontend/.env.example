# Copy to frontend/.env. Vite exposes every VITE_ variable in the browser bundle.
# Use the anon public key only. Never put the service_role key here.

# Project Settings -> API. Example shape: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (not the service_role / sb_secret key)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Copefy FastAPI base URL
VITE_API_URL=http://localhost:8000

# Ask /chat for a metadata-only trace (router, corpus, scores, dates).
# The API does not send raw retrieved journal or clinical text.
VITE_RAG_DEBUG=false

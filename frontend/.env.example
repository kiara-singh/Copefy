# Copefy frontend environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Project settings -> API in the Supabase dashboard.

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The public anon key (safe to expose to the browser)
VITE_SUPABASE_ANON_KEY=

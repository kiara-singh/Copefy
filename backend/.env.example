SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173

# Gemini (free tier for chat + query embeddings)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Comma-separated models tried when the primary is rate-limited or unavailable
GEMINI_CHAT_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.6-flash,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# Optional paid key for ingest / DeepEval (preferred over GEMINI_API_KEY for eval)
GEMINI_INGEST_API_KEY=

# Layer 1 routing: rule | ai
AGENT_ROUTER=rule
AGENT_ROUTER_MODEL=gemini-flash-latest
# Tried in order when the primary judge/router model is 503 or returns empty JSON
AGENT_ROUTER_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-latest,gemini-2.5-flash,gemini-3.6-flash
# Optional. Falls back to GEMINI_API_KEY. Free-tier generateContent quotas are far
# too small for a full eval run, so point this at a billing-enabled project.
# The retrieval LLM-as-judge (`python -m eval.run_judge_compare`) uses this key
# when set, so judge traffic does not fight embedding quota on GEMINI_API_KEY.
AGENT_ROUTER_API_KEY=

# RAG retrieval: baseline | threshold_0.65 | mmr | wide_then_narrow
# Bake-off winner on clinical KB regression (2026-08-20): mmr
RAG_STRATEGY=mmr

# Set true to always include retrieval trace in /chat responses
RAG_DEBUG=true

# Baseline eval only: required for ALL live eval Gemini calls, never falls back.
# Keep the value in ignored backend/.env or the process environment.
EVAL_GEMINI_API_KEY=
# Optional process environment overrides (leave unset to measure current runtime):
# EVAL_GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# EVAL_GEMINI_EMBED_MODEL=gemini-embedding-2

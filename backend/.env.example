# Copefy backend environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.
# Project settings -> API and Project settings -> Database in the dashboard.

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (server-side only, NEVER expose this to the browser)
SUPABASE_SERVICE_KEY=

# Direct Postgres connection string used for pgvector / RAG queries
# e.g. postgresql://postgres:<password>@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

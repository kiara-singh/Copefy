# Copy to backend/.env and fill in your own project. Never commit .env.
# Chat and login use the signed-in Supabase user. The eval ids below are optional.

# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key. Server only. Do not put this in the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key

# Project Settings -> Database. Copy the direct connection URI (port 5432).
# Passed to asyncpg with SSL. This client does not set statement_cache_size=0.
DATABASE_URL=postgresql://postgres:your-database-password@your-direct-db-host:5432/postgres

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Gemini API key for chat, query embeddings, and audio transcription.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary chat model is rate-limited or unavailable.
GEMINI_CHAT_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.6-flash,gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# generateContent model for audio-journal transcription. Same GEMINI_API_KEY.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite

# Optional paid key. Clinical ingest uses it when set and then requires --max-embeds.
# Generation eval also prefers it over GEMINI_API_KEY.
GEMINI_INGEST_API_KEY=

# rule (default) or ai
AGENT_ROUTER=rule
AGENT_ROUTER_MODEL=gemini-flash-latest
# Tried when the AI router or retrieval judge model is unavailable or returns empty JSON.
AGENT_ROUTER_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-latest,gemini-2.5-flash,gemini-3.6-flash
# Optional separate key for the AI router and retrieval judge.
AGENT_ROUTER_API_KEY=

# Clinical KB strategy: baseline | threshold_0.65 | mmr | wide_then_narrow
RAG_STRATEGY=mmr
# Journal hits below this cosine similarity are dropped. Clinical search does not use it.
JOURNAL_MIN_SIMILARITY=0.70
# Prior user/assistant exchanges kept in the generation prompt. The current message is separate.
CHAT_HISTORY_EXCHANGES=8

# If true, /chat includes a metadata-only trace. Retrieved text is not returned.
RAG_DEBUG=false

# Optional. Supabase auth user UUID for journal eval scripts
# (python -m eval.run_judge_compare, run_generation_eval, scripts.reingest_journal_embeddings).
JOURNAL_EVAL_USER_ID=
# Optional. Used by scripts/seed_dummy_journals.py only when the database has no profile row.
SEED_USER_ID=

# Required for every paid baseline call (python -m eval.baseline). No fallback to the keys above.
EVAL_GEMINI_API_KEY=
# Optional process-environment overrides. Leave unset to measure the models above.
# EVAL_GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# EVAL_GEMINI_EMBED_MODEL=gemini-embedding-2

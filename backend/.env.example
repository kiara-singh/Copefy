SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173

# Gemini (free tier for chat + query embeddings)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-2

# Layer 1 routing: rule | ai
AGENT_ROUTER=rule
AGENT_ROUTER_MODEL=gemini-flash-latest
# Optional. Falls back to GEMINI_API_KEY. Free-tier generateContent quotas are far
# too small for a full eval run, so point this at a billing-enabled project.
AGENT_ROUTER_API_KEY=

# RAG retrieval: baseline | threshold_0.65 | mmr | wide_then_narrow
# Bake-off winner on clinical KB regression (2026-08-20): mmr
RAG_STRATEGY=mmr

# Set true to always include retrieval trace in /chat responses
RAG_DEBUG=true
